{
  "name": "@charlietyn/nest-rest-typeorm",
  "version": "1.0.0",
  "description": "Reusable NestJS 11/12 REST CRUD services and controllers for TypeORM, with filtering, pagination, relations, hierarchy and caching.",
  "author": "Charlietyn",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "typeorm",
    "rest",
    "crud",
    "generic",
    "repository",
    "filtering",
    "pagination",
    "hierarchy",
    "cache"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand && node --test test/release.test.mjs",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:package": "node scripts/test-package.mjs",
    "package:check": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/publish-guard.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/typeorm": "^11.0.0 || ^12.0.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "peerDependenciesMeta": {
    "@nestjs/typeorm": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "pdfkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/testing": "^12.2.0",
    "@nestjs/typeorm": "^12.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "eslint": "^9.39.0",
    "exceljs": "^4.4.0",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "semver": "^7.7.3",
    "sqlite3": "^6.0.1",
    "ts-jest": "^29.4.15",
    "typeorm": "^0.3.31",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "testEnvironment": "node"
  },
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlietyn/nest-rest-generic-typeorm.git"
  },
  "homepage": "https://github.com/charlietyn/nest-rest-generic-typeorm#readme",
  "bugs": {
    "url": "https://github.com/charlietyn/nest-rest-generic-typeorm/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
